<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.mygames.vgzseabattle">
    <supports-screens android:anyDensity="true" android:largeScreens="true" android:normalScreens="false" android:resizeable="true" android:smallScreens="false" android:xlargeScreens="true"/>
    <application android:icon="@drawable/ic_launcher" android:label="@string/app_name" android:theme="@style/AppTheme">
        <activity android:label="@string/vgz_sea_battle" android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:label="@string/sea_battle_menu" android:name=".ActivityMenu">
            <intent-filter>
                <action android:name="com.mygames.vgzseabattle.ActivityMenu"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <activity android:label="@string/sea_battle_game_screen" android:name=".ActivityGameScreen">
            <intent-filter>
                <action android:name="com.mygames.vgzseabattle.ActivityGameScreen"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <activity android:label="@string/sea_battle_learn_sounds" android:name=".ActivityLearnSounds">
            <intent-filter>
                <action android:name="com.mygames.vgzseabattle.ActivityLearnSounds"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <activity android:label="@string/sea_battle_learn_game_screen" android:name=".ActivityLearnScreen">
            <intent-filter>
                <action android:name="com.mygames.vgzseabattle.ActivityLearnScreen"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <activity android:label="Sea Battle your top 10 score" android:name=".ActivityViewTop">
            <intent-filter>
                <action android:name="com.mygames.vgzseabattle.ActivityViewTop"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <activity android:label="Sea Battle registration screen" android:name=".RegisterApp">
            <intent-filter>
                <action android:name="com.mygames.vgzseabattle.RegisterApp"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
    </application>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
</manifest>
