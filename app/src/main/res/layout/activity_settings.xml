<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@id/layout_settings"
    android:fitsSystemWindows="true"
    android:background="@drawable/mainBgrn"
    android:orientation="vertical"
    android:padding="16.0dip"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Switch
        android:id="@id/switchOnline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_online"
        android:contentDescription="@string/settings_online" />
    <TextView
        android:id="@id/textOnline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_online_hint"
        android:paddingTop="8.0dip" />
    <TextView
        android:id="@id/textServerUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16.0dip"
        android:text="@string/settings_server_url" />
    <EditText
        android:id="@id/editTextServerUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="textUri"
        android:hint="@string/settings_server_hint" />
    <Button
        android:id="@id/buttonSaveSettings"
        android:layout_width="match_parent"
        android:layout_height="80.0dip"
        android:layout_marginTop="24.0dip"
        android:text="@string/settings_save"
        android:contentDescription="@string/settings_save" />
</LinearLayout>
